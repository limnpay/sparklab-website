# --- Required for production (and for the contact/newsletter forms to deliver) ---

# Formspree form IDs. Both are public values (NEXT_PUBLIC_ prefix), so they ship
# in the client bundle — Formspree form IDs are not secrets.
NEXT_PUBLIC_FORMSPREE_CONTACT_ID=mljereqq
NEXT_PUBLIC_FORMSPREE_NEWSLETTER_ID=xxxxxxxx

# Canonical site origin used for absolute URLs in sitemap.xml, OG tags, JSON-LD.
# Should NOT include a trailing slash. In production use https://sparklabusa.com.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Optional ---

# Plausible analytics. Privacy-friendly, no cookies, ~1KB. Set this to your
# Plausible site domain to enable the tracker. Leave blank for no analytics.
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=sparklabusa.com

# Search Console / Webmaster Tools verification tokens.
# After claiming each property, paste ONLY the token (not the whole meta tag).
# NEXT_PUBLIC_GOOGLE_VERIFICATION=abcdef...
# NEXT_PUBLIC_BING_VERIFICATION=abcdef...
# NEXT_PUBLIC_YANDEX_VERIFICATION=abcdef...
